// סכמת מסד הנתונים – שפרה ופועה, מוסדות חב"ד עפולה
// PostgreSQL על Railway. החיבור דרך DATABASE_URL (Railway מספק אותו אוטומטית).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// סוג המוסד
enum InstitutionType {
  KINDERGARTEN  // גן
  TALMUD_TORAH  // תלמוד תורה
  GIRLS_SCHOOL  // בית ספר לבנות
  CHABAD_HOUSE  // בית חב"ד
  OTHER         // אחר
}

/// מין הנולד/ת
enum BabyGender {
  BOY    // בן
  GIRL   // בת
  TWINS  // תאומים
}

/// מוסד: גן, תלמוד תורה, בית חב"ד וכו'
model Institution {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  type      InstitutionType @default(OTHER)
  isActive  Boolean         @default(true)
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  reporters Reporter[]
  yoldot    Yoledet[]

  @@map("institutions")
}

/// מדווח/ת: המדווח/ת הקבוע/ה של המוסד (מנהל/ת, גננת וכו')
model Reporter {
  id            Int         @id @default(autoincrement())
  name          String
  phone         String?
  role          String?     // לדוגמה: מנהלת, גננת, מזכירה
  isActive      Boolean     @default(true)
  institutionId Int
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  yoldot Yoledet[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@map("reporters")
}

/// יולדת. חובה רק שם וטלפון – כל השאר אפשר להשלים אחר כך
model Yoledet {
  id       Int    @id @default(autoincrement())
  fullName String
  phone    String

  // כתובת (גם המתנדבות יכולות לעדכן)
  street       String?
  houseNumber  String?
  apartment    String? // דירה / קומה / כניסה
  city         String? @default("עפולה")
  addressNotes String? // הכוונה לכתובת, קוד לבניין וכו'

  // מוסדות שבהם לומדים הילדים (אפשר כמה), ומי דיווח/ה
  institutions Institution[]
  reporterId   Int?
  reporter     Reporter?     @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  birthDate   DateTime?   @db.Date // תאריך הלידה
  babyGender  BabyGender?
  preferences String? // העדפות: אוכל, רגישויות, שעות נוחות וכו'
  notes       String?

  visits Visit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reporterId])
  @@index([createdAt])
  @@map("yoldot")
}

/// שיבוץ בסדר היום של המתנדבות: המנהל קובע לאיזו יולדת מגיעים ובאיזה תאריך
model Visit {
  id        Int      @id @default(autoincrement())
  yoledetId Int
  yoledet   Yoledet  @relation(fields: [yoledetId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  note      String? // לדוגמה: ארוחת צהריים, ארוחת שבת, עזרה עם הילדים
  createdAt DateTime @default(now())

  @@unique([yoledetId, date])
  @@index([date])
  @@map("visits")
}
